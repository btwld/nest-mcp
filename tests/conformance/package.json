{
	"name": "@nest-mcp/conformance-harness",
	"version": "0.0.0",
	"private": true,
	"description": "Private harness that runs the official @modelcontextprotocol/conformance server suite against @nest-mcp/server.",
	"type": "module",
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"start": "node --experimental-strip-types src/start.ts",
		"conformance": "node --experimental-strip-types src/run.ts",
		"conformance:modern": "node --experimental-strip-types src/run.ts modern",
		"conformance:legacy": "node --experimental-strip-types src/run.ts legacy",
		"typecheck": "tsc -b",
		"lint": "oxlint --type-aware .",
		"format": "prettier --write . --ignore-unknown",
		"format:check": "prettier --check . --ignore-unknown"
	},
	"dependencies": {
		"@modelcontextprotocol/node": "2.1.2",
		"@modelcontextprotocol/server": "2.4.0",
		"@nest-mcp/server": "workspace:^",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@modelcontextprotocol/conformance": "0.2.0-alpha.12",
		"@types/node": "26.4.0"
	}
}
