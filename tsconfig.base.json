{
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2023",
		"lib": ["es2023", "dom", "dom.iterable"],
		"types": ["node", "vitest/globals"],
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"forceConsistentCasingInFileNames": true,
		"verbatimModuleSyntax": false,
		"isolatedModules": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"removeComments": false,
		"paths": {
			"@nest-mcp/core": ["./packages/core/src/index.ts"],
			"@nest-mcp/client": ["./packages/client/src/index.ts"],
			"@nest-mcp/client/oauth": ["./packages/client/src/oauth/index.ts"],
			"@nest-mcp/client/oauth/dynamic-registration": [
				"./packages/client/src/oauth/dynamic-registration.ts"
			],
			"@nest-mcp/manager": ["./packages/manager/src/index.ts"],
			"@nest-mcp/conformance": ["./packages/conformance/src/index.ts"],
			"@nest-mcp/server": ["./packages/server/src/index.ts"],
			"@nest-mcp/server/auth": ["./packages/server/src/auth/index.ts"],
			"@nest-mcp/server/security": ["./packages/server/src/security/index.ts"],
			"@nest-mcp/server/testing": ["./packages/server/src/testing/index.ts"],
			"@nest-mcp/apps": ["./packages/apps/src/index.ts"],
			"@nest-mcp/auth": ["./packages/auth/src/index.ts"],
			"@nest-mcp/auth/cimd": ["./packages/auth/src/cimd/index.ts"],
			"@nest-mcp/auth/stores": ["./packages/auth/src/stores/index.ts"],
			"@nest-mcp/auth/testing": ["./packages/auth/src/testing/index.ts"],
			"@nest-mcp/observability": ["./packages/observability/src/index.ts"],
			"@nest-mcp/gateway": ["./packages/gateway/src/index.ts"],
			"@nest-mcp/gateway/testing": ["./packages/gateway/src/testing/index.ts"],
			"@nest-mcp/nestjs": ["./packages/nestjs/src/index.ts"],
			"@nest-mcp/nestjs/client": ["./packages/nestjs/src/client/index.ts"],
			"@nest-mcp/nestjs/manager": ["./packages/nestjs/src/manager/index.ts"],
			"@nest-mcp/nestjs/testing": ["./packages/nestjs/src/testing/index.ts"]
		}
	}
}
